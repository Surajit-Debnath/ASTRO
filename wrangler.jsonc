{
	"name": "cloudflare-hono-waitlist-template",
    "compatibility_date":"2026-11-16",
	"main": "src/server/index.ts",
	"assets": {
		"directory":"./dist",
		"binding":"ASSETS"
	},
	"env": {
		"staging": {
			"vars": {
				"ENVIRONMENT": "staging"
			}
		},
		"production": {
			"vars": {
				"ENVIRONMENT": "production"
			}
		}
	}
}